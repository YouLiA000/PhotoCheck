{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://photocheck.local/contract/schema/photocheck-v4.schema.json",
  "title": "PhotoCheck 共享契约 v4",
  "description": "五类独立记录（ImageDescriptor / Detection / Decision / RedactionPlan / VerificationReport）的严格定义。每条记录必须带 contract_version=\"photocheck/v4\" 与 record_type；禁止未知字段。原始文字、二维码 payload、EXIF 值与内嵌缩略图不进入任何可序列化记录。跨记录不变量（引用完整性、revision 连续性、disposal_state 推导）由 validate_records.py 检查，不在本文件内表达。",
  "oneOf": [
    { "$ref": "#/$defs/ImageDescriptor" },
    { "$ref": "#/$defs/Detection" },
    { "$ref": "#/$defs/Decision" },
    { "$ref": "#/$defs/RedactionPlan" },
    { "$ref": "#/$defs/VerificationReport" }
  ],
  "$defs": {
    "contractVersion": {
      "description": "契约版本号，v4 记录固定为该值。",
      "const": "photocheck/v4"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "kindEnum": {
      "description": "Finding 大类。",
      "enum": ["meta", "text", "qr", "face"]
    },
    "subtypeMetaEnum": {
      "description": "meta 类 subtype。",
      "enum": ["gps", "datetime", "device", "serial", "thumbnail", "software"]
    },
    "subtypeTextEnum": {
      "description": "text 类 subtype。v1.4 只保留手机号与身份证号。",
      "enum": ["phone", "idcard"]
    },
    "subtypeQrEnum": {
      "description": "qr 类 subtype。",
      "enum": [
        "qr_wechat_card",
        "qr_wechat_group",
        "qr_wechat_pay",
        "qr_alipay",
        "qr_wifi",
        "qr_vcard",
        "qr_contact",
        "qr_geo",
        "qr_code",
        "qr_link",
        "qr_unknown"
      ]
    },
    "subtypeFaceEnum": {
      "description": "face 类 subtype，只有一种。",
      "enum": ["face_region"]
    },
    "evidenceEnum": {
      "description": "结论来源。与 kind 固定对应：meta=exif, text=ocr_rule, qr=qr_payload, face=face_box。",
      "enum": ["exif", "ocr_rule", "qr_payload", "face_box"]
    },
    "bbox": {
      "description": "方向矫正后工作图的 [x, y, width, height]，整数像素，坐标系固定 top_left_pixels。",
      "type": "array",
      "prefixItems": [
        { "type": "integer", "minimum": 0 },
        { "type": "integer", "minimum": 0 },
        { "type": "integer", "minimum": 1 },
        { "type": "integer", "minimum": 1 }
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "nullableBbox": {
      "description": "meta 类必须为 null（元数据没有像素位置），其余 kind 必须给出合法 bbox。",
      "oneOf": [
        { "$ref": "#/$defs/bbox" },
        { "type": "null" }
      ]
    },
    "detailsMeta": {
      "description": "meta 的 details 只允许安全摘要，不得塞入 EXIF 原值。",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "masked_preview": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "detailsText": {
      "description": "text 的 details。masked_preview 必须含 * 掩码；身份证号必须给 idcard_check 三态。",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "masked_preview": {
          "type": "string",
          "pattern": "\\*"
        },
        "idcard_check": {
          "description": "pass=校验位正确(risk 3)；fail=格式像但不通过(risk 2)；na=非身份证类。",
          "enum": ["pass", "fail", "na"]
        }
      }
    },
    "detailsQr": {
      "description": "qr 的 details。decodable 必填；其余只允许域名 / SSID 等安全摘要，禁止 payload 原文。规范字段只有 safe_domain / safe_ssid，不接受过渡别名。",
      "type": "object",
      "additionalProperties": false,
      "required": ["decodable"],
      "properties": {
        "decodable": { "type": "boolean" },
        "safe_domain": {
          "type": "string",
          "minLength": 3,
          "maxLength": 253,
          "pattern": "^[^/\\\\:@:;?#%&=+\\s]+$",
          "description": "只放域名（小写、无协议/路径/参数），如 example.com。"
        },
        "safe_ssid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\u0000-\\u001f]+$",
          "description": "Wi-Fi SSID 明文摘要，拒绝控制字符。"
        }
      }
    },
    "detailsFace": {
      "description": "face 的 details 不允许任何字段（不做身份、性别、年龄、情绪推断）。",
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "ImageDescriptor": {
      "type": "object",
      "description": "描述规范化工作图。",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "record_type",
        "image_id",
        "width",
        "height",
        "orientation",
        "coordinate_space"
      ],
      "properties": {
        "contract_version": { "$ref": "#/$defs/contractVersion" },
        "record_type": { "const": "ImageDescriptor" },
        "image_id": { "$ref": "#/$defs/nonEmptyString" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "orientation": {
          "description": "exif_transposed=已按 EXIF 方向矫正；as_stored=原样未矫正。",
          "enum": ["exif_transposed", "as_stored"]
        },
        "coordinate_space": { "const": "top_left_pixels" }
      }
    },
    "Detection": {
      "type": "object",
      "description": "只读检测事实，只由检测器产生；不含用户选择、复检状态或原始敏感值。",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "record_type",
        "id",
        "image_id",
        "kind",
        "subtype",
        "bbox",
        "detector_score",
        "evidence",
        "risk",
        "details"
      ],
      "properties": {
        "contract_version": { "$ref": "#/$defs/contractVersion" },
        "record_type": { "const": "Detection" },
        "id": {
          "description": "在一个 image_id 内唯一；多个检测器不得复用同一个 ID。",
          "$ref": "#/$defs/nonEmptyString"
        },
        "image_id": { "$ref": "#/$defs/nonEmptyString" },
        "kind": { "$ref": "#/$defs/kindEnum" },
        "subtype": { "type": "string" },
        "bbox": { "$ref": "#/$defs/nullableBbox" },
        "detector_score": {
          "description": "0～1 或 null。只用于排序与阈值过滤，不是校准概率。",
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "evidence": { "$ref": "#/$defs/evidenceEnum" },
        "risk": {
          "description": "固定 1 / 2 / 3 级策略标签，与 detector_score 分离。",
          "type": "integer",
          "enum": [1, 2, 3]
        },
        "details": { "type": "object" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "meta" } },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "subtype": { "$ref": "#/$defs/subtypeMetaEnum" },
              "bbox": { "type": "null" },
              "evidence": { "const": "exif" },
              "details": { "$ref": "#/$defs/detailsMeta" }
            }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "text" } },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "subtype": { "$ref": "#/$defs/subtypeTextEnum" },
              "bbox": { "$ref": "#/$defs/bbox" },
              "evidence": { "const": "ocr_rule" },
              "details": { "$ref": "#/$defs/detailsText" }
            },
            "allOf": [
              {
                "if": {
                  "properties": { "subtype": { "const": "idcard" } },
                  "required": ["subtype"]
                },
                "then": {
                  "properties": {
                    "details": {
                      "required": ["idcard_check"]
                    }
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "qr" } },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "subtype": { "$ref": "#/$defs/subtypeQrEnum" },
              "bbox": { "$ref": "#/$defs/bbox" },
              "evidence": { "const": "qr_payload" },
              "details": { "$ref": "#/$defs/detailsQr" }
            }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "face" } },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "subtype": { "$ref": "#/$defs/subtypeFaceEnum" },
              "bbox": { "$ref": "#/$defs/bbox" },
              "evidence": { "const": "face_box" },
              "details": { "$ref": "#/$defs/detailsFace" }
            }
          }
        }
      ]
    },
    "Decision": {
      "type": "object",
      "description": "用户当前决定。只有 redact / retain；每个 Finding 最多一个当前决定。元数据不接受 Decision。",
      "additionalProperties": false,
      "required": ["contract_version", "record_type", "finding_id", "action", "revision"],
      "properties": {
        "contract_version": { "$ref": "#/$defs/contractVersion" },
        "record_type": { "const": "Decision" },
        "finding_id": { "$ref": "#/$defs/nonEmptyString" },
        "action": {
          "description": "redact=确认遮盖；retain=用户选择保留（不进 RedactionPlan）。",
          "enum": ["redact", "retain"]
        },
        "revision": {
          "description": "任何决定变化都递增 revision，旧验证报告立即失效。",
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "RedactionPlanItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "finding_id", "bbox", "method"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "finding_id": {
          "description": "手动补框为 null，不伪造为 Detection。",
          "oneOf": [
            { "$ref": "#/$defs/nonEmptyString" },
            { "type": "null" }
          ]
        },
        "bbox": { "$ref": "#/$defs/bbox" },
        "method": {
          "description": "首版默认 solid；blur / mosaic 只能显式附加。二维码区域必须 solid。",
          "enum": ["solid", "blur", "mosaic"]
        }
      }
    },
    "RedactionPlan": {
      "type": "object",
      "description": "像素处理计划，由 redact 决定与手动框生成。",
      "additionalProperties": false,
      "required": ["contract_version", "record_type", "image_id", "revision", "items"],
      "properties": {
        "contract_version": { "$ref": "#/$defs/contractVersion" },
        "record_type": { "const": "RedactionPlan" },
        "image_id": { "$ref": "#/$defs/nonEmptyString" },
        "revision": { "type": "integer", "minimum": 1 },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/RedactionPlanItem" }
        }
      }
    },
    "VerificationCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region_id", "status", "method"],
      "properties": {
        "region_id": { "$ref": "#/$defs/nonEmptyString" },
        "status": {
          "description": "not_run / not_applicable 都使 disposal_state 停在 pending。",
          "enum": ["passed", "failed", "not_run", "not_applicable"]
        },
        "method": {
          "description": "复检所用的检查手段；使用小写标识符，允许检测器实现与降级原因的具体名称。",
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      }
    },
    "VerificationResidual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region_id", "finding_id", "reason", "kind", "subtype", "masked_summary"],
      "properties": {
        "region_id": {
          "oneOf": [
            { "$ref": "#/$defs/nonEmptyString" },
            { "type": "null" }
          ]
        },
        "finding_id": {
          "oneOf": [
            { "$ref": "#/$defs/nonEmptyString" },
            { "type": "null" }
          ]
        },
        "reason": {
          "description": "retained=用户选择保留；verification_failed=处理后仍检出。不含首次漏检。",
          "enum": ["retained", "verification_failed"]
        },
        "kind": {
          "description": "人工补框失败可使用 manual；其余取 Detection.kind。",
          "enum": ["meta", "text", "qr", "face", "manual"]
        },
        "subtype": { "$ref": "#/$defs/nonEmptyString" },
        "masked_summary": {
          "description": "只存 kind/subtype 级掩码摘要，例如 qr/qr_contact。",
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "VerificationReport": {
      "type": "object",
      "description": "最终文件复检结论，必须绑定 plan_revision；过期结果禁止用于当前计划。",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "record_type",
        "image_id",
        "plan_revision",
        "disposal_state",
        "checks",
        "residuals"
      ],
      "properties": {
        "contract_version": { "$ref": "#/$defs/contractVersion" },
        "record_type": { "const": "VerificationReport" },
        "image_id": { "$ref": "#/$defs/nonEmptyString" },
        "plan_revision": { "type": "integer", "minimum": 1 },
        "disposal_state": {
          "description": "not_applicable=无待处理区域；pending=未复检或存在 not_run/not_applicable；failed=至少一个区域失败；passed=全部待处理区域通过。",
          "enum": ["not_applicable", "pending", "passed", "failed"]
        },
        "checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/VerificationCheck" }
        },
        "residuals": {
          "type": "array",
          "items": { "$ref": "#/$defs/VerificationResidual" }
        }
      }
    }
  }
}
