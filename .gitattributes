# Cross-machine consistency: source/data use LF, Windows scripts use CRLF.
* text=auto
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.png binary
*.jpg binary
*.pdf binary
*.docx binary

# The lock set is sealed by byte hashes; line-ending normalisation invalidates it.
dataset/lock/** -text
